# Copy to .env.local for local runs. On Vercel set these in Project > Settings > Environment Variables.
# Never paste the real values into chat or commit them.
DATABASE_URL=postgres://user:password@host.neon.tech/db?sslmode=require
AUTH_SECRET=            # 32+ random characters (signs the login cookie)
TOKEN_KEY=              # 64 hex characters (32 bytes): encrypts the social account tokens
APP_URL=https://your-app.vercel.app
CRON_SECRET=            # random text; the GitHub Actions sweep sends it as a Bearer token

# Upstash QStash (exact-time publishing)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Vercel Blob (images)
BLOB_READ_WRITE_TOKEN=

# LinkedIn app 1: company Pages (Community Management API)
LINKEDIN_PAGE_CLIENT_ID=
LINKEDIN_PAGE_CLIENT_SECRET=
# LinkedIn app 2: personal profiles (Share on LinkedIn + Sign In with LinkedIn using OpenID Connect)
LINKEDIN_MEMBER_CLIENT_ID=
LINKEDIN_MEMBER_CLIENT_SECRET=

# Google Gemini (AI assist: post writing, card text, AI pictures). Key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
